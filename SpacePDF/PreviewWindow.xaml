<Window x:Class="SpacePDF.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpacePDF"
        xmlns:models="clr-namespace:SpacePDF.Models"
        Title="SpacePDF - Preview" Height="800" Width="1100"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <DataTemplate x:Key="ImageSliceTemplate"
                      DataType="{x:Type models:DocumentBlock}">
            <Image Source="{Binding Image}" Stretch="None"/>
        </DataTemplate>
        <DataTemplate x:Key="BlankSpaceTemplate"
                      DataType="{x:Type models:DocumentBlock}">
            <Rectangle Fill="White"
                       Width="{Binding DisplayWidthPx}"
                       Height="{Binding DisplayHeightPx}"/>
        </DataTemplate>
        <local:BlockTemplateSelector x:Key="BlockTemplateSelector"
            ImageSliceTemplate="{StaticResource ImageSliceTemplate}"
            BlankSpaceTemplate="{StaticResource BlankSpaceTemplate}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Save PDF" Click="SavePdf_Click"
                            Width="100" Height="32"
                            Background="#3B82F6" Foreground="White"
                            BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#x2212;" Click="ZoomOut_Click"
                            Width="32" Height="32" FontSize="16"
                            Background="#F1F5F9" BorderThickness="0"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="52"
                               TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" Foreground="#475569"/>
                    <Button Content="+" Click="ZoomIn_Click"
                            Width="32" Height="32" FontSize="16"
                            Background="#F1F5F9" BorderThickness="0"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: shared ScrollViewer with side-by-side panels -->
        <ScrollViewer Grid.Row="1" x:Name="PdfScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#E2E8F0"
                      PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel">
            <Grid x:Name="ContentGrid" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid x:Name="ScaleTarget" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: PDF Preview (display-only) -->
                    <ItemsControl Grid.Column="0" x:Name="PdfPreviewControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PageModel}">
                                <Border Margin="20,10" BorderBrush="#CBD5E1"
                                        BorderThickness="1" Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                          Opacity="0.1"/>
                                    </Border.Effect>
                                    <Canvas Width="{Binding DisplayWidthPx}"
                                            Height="{Binding DisplayHeightPx}"
                                            Background="White">
                                        <ItemsControl
                                            ItemsSource="{Binding Blocks}"
                                            IsHitTestVisible="False"
                                            ItemTemplateSelector="{StaticResource BlockTemplateSelector}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="0"/>
                                                    <Setter Property="Canvas.Top"
                                                            Value="{Binding YPositionPx}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Right: Interaction Panel -->
                    <Grid Grid.Column="1" x:Name="InteractionRoot"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          MouseLeftButtonDown="InteractionRoot_MouseLeftButtonDown"
                          MouseMove="InteractionRoot_MouseMove"
                          MouseLeftButtonUp="InteractionRoot_MouseLeftButtonUp">
                        <ItemsControl x:Name="InteractionPagesControl"
                                      IsHitTestVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PageModel}">
                                    <Border BorderBrush="#64748B"
                                            BorderThickness="0,0,0,2"
                                            Margin="0,10"
                                            Width="220"
                                            Height="{Binding DisplayHeightPx}"
                                            Background="#F8FAFC">
                                        <ItemsControl ItemsSource="{Binding Blocks}"
                                                      IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:DocumentBlock}">
                                                    <Rectangle Width="220"
                                                               Height="{Binding DisplayHeightPx}">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill"
                                                                        Value="#CBD5E1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger
                                                                        Binding="{Binding Type}"
                                                                        Value="UserInsertedBlank">
                                                                        <Setter Property="Fill"
                                                                                Value="#4CAF50"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="0"/>
                                                    <Setter Property="Canvas.Top"
                                                            Value="{Binding YPositionPx}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12"
                           Foreground="#64748B" HorizontalAlignment="Left"/>
                <TextBlock x:Name="VersionText" Text="v0" FontSize="12"
                           Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
