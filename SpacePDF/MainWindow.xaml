<Window
    x:Class="SpacePDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SpacePDF"
    Width="540"
    Height="340"
    Background="{StaticResource BackgroundBrush}"
    ResizeMode="CanMinimize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>

        <Border
            Width="440"
            Height="220"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20"
                    Opacity="0.12"
                    ShadowDepth="4" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1E293B"
                    Text="SpacePDF" />
                <TextBlock
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#94A3B8"
                    Text="PDF Whitespace Editor" />

                <Button
                    x:Name="SelectPdfButton"
                    Width="200"
                    Height="40"
                    Click="SelectPdfButton_Click"
                    Content="打开PDF文件"
                    FontSize="14" />
                <TextBlock
                    x:Name="VersionLabel"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#64748B"
                    Text="" />

                <Button
                    x:Name="OpenPreviewButton"
                    Width="200"
                    Height="36"
                    Margin="0,0,0,0"
                    BorderThickness="0"
                    Content="预览"
                    Click="OpenPreviewButton_Click"
                    FontSize="13"
                    IsEnabled="False">
                </Button>
                <TextBlock
                    x:Name="FilePathText"
                    MaxWidth="380"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#94A3B8"
                    Text="No file selected"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
